<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.itemmanagement.mapper.RecipeCategoryMapper">

    <select id="findAll" resultType="com.example.itemmanagement.entity.RecipeCategory">
        SELECT
            id,
            name
        FROM recipe_category
        ORDER BY id ASC
    </select>

</mapper>
